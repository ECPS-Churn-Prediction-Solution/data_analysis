# ===== AWS / S3 =====
AWS_REGION=ap-northeast-2
AWS_PROFILE=default                 # 로컬만; Lambda/SageMaker는 역할 사용
S3_ENDPOINT_URL=                    # MinIO/프록시 없으면 비움

# [고정] 사용자 제공 버킷명
S3_BUCKET=kdt3-preprocessing-data

# TODO(추후 수정): 경로/파티션 포맷 확정 시 갱신
S3_FEATURE_PREFIX=features/
S3_FEATURE_PARTITION_FMT=dt=%Y-%m-%d
S3_MODEL_PREFIX=models/lgbm/
S3_PREDICTION_PREFIX=predictions/

# 선택: SSE/KMS/RequesterPays
S3_SSE=
S3_KMS_KEY_ID=
S3_REQUEST_PAYER=

# ===== 모델/피처 버전 =====
MODEL_VERSION=lgbm_v1.0_shaTODO     # TODO(추후 수정)
FEATURE_VERSION=feat_v1.0           # TODO(추후 수정)
HORIZON_DAYS=90

# ===== DB (적재용) =====
PGHOST=localhost                    # TODO(추후 수정)
PGPORT=5432
PGDATABASE=postgres                 # TODO(추후 수정)
PGUSER=postgres                     # TODO(추후 수정)
PGPASSWORD=                         # TODO(추후 수정)
