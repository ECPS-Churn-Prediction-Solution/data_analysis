# ===== AWS / S3 =====
AWS_REGION=ap-northeast-2
AWS_PROFILE=default
S3_BUCKET=ecps-event-log

# Features (Glue 출력과 일치)
S3_FEATURE_PREFIX=features/                 # dt=YYYY-MM-DD/ 자동
S3_FEATURE_PARTITION_FMT=dt=%Y-%m-%d      # (predict_lgbm 패치 시 사용)

# Models
S3_MODEL_PREFIX=lgbm/
S3_MODEL_BUCKET=ecps-models

# Predictions export
S3_PREDICTION_BUCKET=ecps-prediction
S3_PREDICTION_PREFIX=predictions/
WRITE_PREDICTIONS_TO_S3=1                  # S3에도 raw 예측 저장하려면 1

# 선택: SSE/KMS/RequesterPays
S3_SSE=
S3_KMS_KEY_ID=
S3_REQUEST_PAYER=

# ===== Model / Features =====
MODEL_VERSION=lgbm_v1.0_shaTODO
FEATURE_VERSION=feat_v1.0
MODEL_NAME=lgbm
CHURN_HORIZON_DAYS=30

# ===== SHAP/Batch (옵션) =====
PREDICT_COMPUTE_SHAP=0
PREDICT_SHAP_APPROX=1
PREDICT_BATCH_SIZE=50000
SHAP_BATCH_SIZE=20000

# ===== DB =====
PG_HOST=ecps.c1caeqgae69.ap-northeast-2.rds.amazonaws.com
PG_PORT=5432
PG_DB=ecps
PG_USER=postgres
PG_PASSWORD=qwer1234!
PG_SSLMODE=require
