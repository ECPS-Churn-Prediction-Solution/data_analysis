# 기본: 텍스트 파일은 모두 LF
*          text=auto eol=lf

# 반드시 LF여야 하는 것들
*.sh       text eol=lf
*.bash     text eol=lf
*.py       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.tf       text eol=lf
*.toml     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf

# 윈도우 전용 스크립트는 CRLF 유지(원하면)
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# 바이너리
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.zip      binary
*.parquet  binary
*.pkl      binary
