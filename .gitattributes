# 기본: 텍스트는 리포지토리에 LF로 저장
* text=auto eol=lf

# 윈도우 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 유닉스/리눅스 스크립트는 LF 강제
*.sh text eol=lf

# 보통 코드/설정 파일은 LF
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.env.example text eol=lf

# 바이너리
*.parquet binary
*.png binary
*.jpg binary
*.zip binary
*.gz binary
