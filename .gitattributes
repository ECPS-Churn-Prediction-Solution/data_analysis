# 기본: 리포지토리엔 LF로 저장
* text=auto eol=lf

# 윈도우 스크립트만 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 유닉스 스크립트/코드/설정은 LF
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.env.example text eol=lf

# 바이너리
*.parquet binary
*.png binary
*.jpg binary
*.zip binary
*.gz binary
